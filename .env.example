# Public URL of the live site (canonical links, sitemap, social cards). Baked in at build time,
# so set it in the GitHub Actions workflow env for production builds, not just here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: a public email address to show in the footer, contact page and privacy policy.
NEXT_PUBLIC_CONTACT_EMAIL=

# The enquiry form posts straight to Formspree (https://formspree.io) client-side; there's no
# server, so no API keys to configure here. The endpoint is set in components/contact-form.tsx.
