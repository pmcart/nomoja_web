# Where enquiries from the website form are delivered.
CONTACT_TO_EMAIL=patrickmcart@gmail.com

# Email delivery via Resend (https://resend.com). Create an API key and paste it here.
# Until this is set, the form works in local development (enquiries are printed to the
# terminal) but does NOT deliver email in production.
RESEND_API_KEY=

# Sender address. Until you verify your own domain in Resend, use their test sender below.
# With an unverified domain Resend typically only delivers to the address your Resend
# account was created with, so sign up with the same address you set in CONTACT_TO_EMAIL.
CONTACT_FROM_EMAIL=Nomoja <onboarding@resend.dev>

# Public URL of the live site (canonical links, sitemap, social cards).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: a public email address to show in the footer, contact page and privacy policy.
NEXT_PUBLIC_CONTACT_EMAIL=
